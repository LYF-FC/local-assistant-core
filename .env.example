# Butler core - copy to .env and replace placeholders.
# Never commit the real .env file.

BUTLER_POSTGRES_DB=butler
BUTLER_POSTGRES_USER=butler
BUTLER_POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Bound to localhost by default. Caddy/VPN architecture will evolve later.
BUTLER_HTTP_PORT=8080

# From containers, OrbStack reaches native macOS services through this host bridge.
BUTLER_OLLAMA_URL=http://host.docker.internal:11434

BUTLER_ENV=development

# Household/local TTS POC.
# phonon:40m-multilingual is CC BY-NC 4.0: do not use for business/business output.
BUTLER_SPEECH_ENABLED=false
BUTLER_SPEECH_MODEL=phonon:40m-multilingual
BUTLER_SPEECH_VOICE=default


# Exact HTTPS browser origin for the identity API (host TLS integration is separate).
BUTLER_AUTH_ORIGIN=https://localhost:8443

# Separate API runtime credential; migration/admin credentials never enter the API.
BUTLER_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME_WITH_A_LONG_RANDOM_VALUE

# Loopback HTTPS for local browser sign-in; match BUTLER_AUTH_ORIGIN when changed.
BUTLER_HTTPS_PORT=8443

# Separate fresh-installation project; never reuse an existing private deployment.
COMPOSE_PROJECT_NAME=local-assistant-core-dev
